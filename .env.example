# ---- Vercel project (Settings -> Environment Variables) ----
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres   # required for the real backend
SESSION_SECRET=generate-with-openssl-rand-hex-32                                              # required in production
ML_SERVICE_URL=https://smart-mess-ml.onrender.com        # optional: without it forecasts use the 7-day average
ML_API_KEY=same-value-as-on-the-ml-service               # server-side only
ML_TIMEOUT_MS=25000                                       # free ML hosts sleep; first call can take 30-50 s
# QR_SECRET=                                              # optional; changing it invalidates printed QR codes
# WARDEN_WEBHOOK_SECRET=                                  # optional; enables POST /api/warden/webhook
# FORECAST_CACHE_MINUTES=180
# DATABASE_SSL=off                                        # only for a local non-SSL Postgres

# ---- Local ----
PORT=3000
# LOCAL_DB=pglite        # run the real backend on an in-process Postgres (data in .data/)
# SEED_PASSWORD=demo1234 # demo login password for the seeded accounts
