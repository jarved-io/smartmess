{
  "name": "smart-mess",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "mock": "node mock/mock-api.js",
    "demo": "node scripts/demo.js",
    "check": "node scripts/check.js",
    "test": "node --test test/calc.test.js test/api.test.js test/dashboard.test.js test/static.test.js test/ml-adapter.test.js test/backend.test.js test/live-ui.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "ml-proxy": "node adapters/ml-proxy.js",
    "dev": "node server.js",
    "db:migrate": "node scripts/db.js migrate",
    "db:seed": "node scripts/db.js seed",
    "db:reset-seed": "node scripts/db.js reset-seed",
    "dev:live": "LOCAL_DB=pglite node server.js",
    "test:backend": "node --test test/backend.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "jsdom": "^30.1.3",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Smart Mess: hostel meal tracking dashboard with XGBoost meal-demand forecasting",
  "dependencies": {
    "dotenv": "^18.0.8",
    "pg": "^8.23.1"
  }
}
